<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>


<BorderPane prefHeight="200.0" prefWidth="200.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ejercicioclase_bustelo.controllers.createController">
   <top>
      <Label text="Crear nuevo registro" BorderPane.alignment="CENTER" />
   </top>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Nombre" />
            <TextField fx:id="tfNombre">
               <VBox.margin>
                  <Insets bottom="15.0" />
               </VBox.margin>
            </TextField>
            <Label text="Descripción" />
            <TextArea fx:id="taDescripcion" prefHeight="200.0" prefWidth="200.0">
               <VBox.margin>
                  <Insets bottom="15.0" />
               </VBox.margin>
            </TextArea>
            <Label text="Fecha" />
            <DatePicker fx:id="dateFecha">
               <VBox.margin>
                  <Insets bottom="15.0" />
               </VBox.margin>
            </DatePicker>
            <Label text="Estado" />
            <ChoiceBox fx:id="pickEstado" prefWidth="150.0">
               <VBox.margin>
                  <Insets bottom="15.0" />
               </VBox.margin>
            </ChoiceBox>
         </children>
      </VBox>
   </center>
   <bottom>
      <FlowPane BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#onGuardarClick" text="Guardar" />
            <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#onCancelarClick" text="Cancelar" />
         </children>
      </FlowPane>
   </bottom>
</BorderPane>
